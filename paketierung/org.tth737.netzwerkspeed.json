{
  "id": "org.tth737.netzwerkspeed",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "netzwerkspeed",
  "separate-locales": false,
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=ipc"
  ],
  "modules": [
    {
      "name": "netzwerk-speed",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/lib/netzwerkspeed /app/bin",
        "cp -a bundle/. /app/lib/netzwerkspeed/",
        "chmod +x /app/lib/netzwerkspeed/netzwerkspeed",
        "install -d /app/share/applications /app/share/icons",
        "cp -a bundle/share/applications/. /app/share/applications/",
        "cp -a bundle/share/icons/. /app/share/icons/",
        "find /app/share/icons -name 'None.png' -delete",
        "install -d /app/share/licenses/org.tth737.netzwerkspeed /app/share/metainfo",
        "install -m 0644 LICENSE /app/share/licenses/org.tth737.netzwerkspeed/LICENSE",
        "install -m 0644 org.tth737.netzwerkspeed.metainfo.xml /app/share/metainfo/org.tth737.netzwerkspeed.metainfo.xml"
      ],
      "post-install": [
        "install -d /app/bin",
        "printf '#!/bin/sh\\ncd /app/lib/netzwerkspeed && exec ./netzwerkspeed \"$@\"\\n' > /app/bin/netzwerkspeed",
        "chmod 755 /app/bin/netzwerkspeed"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../build/linux",
          "dest": "bundle"
        },
        {
          "type": "file",
          "path": "../LICENSE"
        },
        {
          "type": "file",
          "path": "org.tth737.netzwerkspeed.metainfo.xml"
        }
      ]
    }
  ]
}